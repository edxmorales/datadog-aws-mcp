# Copia este archivo a .env y completa tus valores reales.
# NUNCA subas tu .env real a git (debe estar en .gitignore).
#
# TODAS las secciones de abajo son opcionales de forma independiente.
# No hace falta llenarlas todas: activa solo las fuentes que vayas a
# usar, en la combinación que quieras (solo AWS, solo Datadog, AWS +
# GitHub, las 4, etc.). Deja vacías las que no uses — el resto del
# servidor sigue funcionando normal.

# --- Datadog (opcional) ---
# API Keys en: https://app.datadoghq.com/organization-settings/api-keys
DD_API_KEY=
# Application Keys en: https://app.datadoghq.com/organization-settings/application-keys
DD_APP_KEY=
# Sitio de tu cuenta Datadog: datadoghq.com (US1), datadoghq.eu (EU), us3.datadoghq.com, etc.
DD_SITE=datadoghq.com

# --- AWS CloudWatch (opcional) ---
# Región donde están tus log groups. Las credenciales de AWS NO van aquí:
# usa `aws configure`, variables AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY,
# o un rol/perfil — boto3 las toma automáticamente del entorno estándar.
# (Si Claude Desktop está instalado como app empaquetada de Windows y no
# ve tu ~/.aws/credentials, define aquí mismo AWS_ACCESS_KEY_ID y
# AWS_SECRET_ACCESS_KEY explícitas como variables adicionales.)
AWS_REGION=us-east-1

# --- Azure Repos / Azure DevOps (opcional) ---
# Solo necesario si quieres que Claude pueda leer código fuente de repos
# alojados en Azure Repos (herramientas azure_devops_list_projects,
# azure_repos_list_repos, azure_repos_get_file, azure_repos_search_code).
# Si dejas estas dos vacías, esas herramientas simplemente no funcionan
# (devuelven un error explicando qué falta) y el resto del servidor
# sigue funcionando normal.
#
# Nombre de tu organización (el que aparece en https://dev.azure.com/<org>)
AZURE_DEVOPS_ORG=
# Personal Access Token con scope de SOLO LECTURA "Code (Read)".
# Créalo en: https://dev.azure.com/<tu-org>/_usersSettings/tokens
AZURE_DEVOPS_PAT=
# Versión de la API de Azure DevOps a usar (normalmente no hace falta tocarla)
AZURE_DEVOPS_API_VERSION=7.1

# --- GitHub (opcional) ---
# Solo necesario si quieres que Claude pueda leer código fuente de repos
# alojados en GitHub (herramientas github_list_repos, github_get_file,
# github_search_code).
#
# Sin token, github_list_repos/github_get_file funcionan igual pero solo
# ven repos PÚBLICOS. github_search_code siempre requiere token (la
# Search API de GitHub no acepta búsquedas sin autenticación).
# Fine-grained PAT con scope de SOLO LECTURA "Contents: Read-only":
# https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=
# Cambia solo si usas GitHub Enterprise Server (no GitHub.com)
GITHUB_API_URL=https://api.github.com

# --- Memoria de incidentes (opcional) ---
# Ruta del archivo donde se guarda el historial de diagnósticos/fixes.
# Por defecto usa incident_history.json junto a server.py.
# INCIDENT_HISTORY_PATH=
